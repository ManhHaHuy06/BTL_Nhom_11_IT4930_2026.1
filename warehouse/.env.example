# OCI Object Storage S3 compatibility credentials. Use the same bucket/endpoint
# as the crawler; never commit the populated .env file.
S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-singapore-1.oci.customer-oci.com
S3_REGION=ap-singapore-1
S3_ACCESS_KEY=replace_with_oci_access_key
S3_SECRET_KEY=replace_with_oci_secret_key
DATA_BUCKET=raw-zone

# MySQL 8.4 connection.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wildfire_dw
MYSQL_USER=wildfire_etl
MYSQL_PASSWORD=replace_with_local_password
MYSQL_USE_SSL=false

# Match hadoop-aws to the Hadoop version bundled with Spark and include the
# MySQL Connector/J Maven coordinate, e.g. org.apache.hadoop:hadoop-aws:X.Y.Z,
# com.mysql:mysql-connector-j:A.B.C. Leave blank only if both jars are already
# on the Spark classpath.
SPARK_JARS_PACKAGES=
SPARK_MASTER=local[*]
ETL_JDBC_BATCH_SIZE=5000
ETL_JDBC_PARTITIONS=2
