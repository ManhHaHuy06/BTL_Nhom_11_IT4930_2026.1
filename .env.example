# OCI Object Storage S3 compatibility endpoint (Singapore)
S3_ENDPOINT=https://ax7w18msxzt6.compat.objectstorage.ap-singapore-1.oci.customer-oci.com
S3_REGION=ap-singapore-1
S3_ACCESS_KEY=replace_with_your_read_only_access_key
S3_SECRET_KEY=replace_with_your_read_only_secret_key
DATA_BUCKET=raw-zone
# Only the ingestion job or an authorized operator needs this bucket.
STATE_BUCKET=system-state
