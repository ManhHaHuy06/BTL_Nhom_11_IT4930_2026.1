# Pipeline-only Kaggle settings; readers do not need a Kaggle token.
KAGGLE_API_TOKEN=replace_with_kaggle_api_token
KAGGLE_ENDPOINT=https://www.kaggle.com/datasets/firecastrl/us-wildfire-dataset
CHUNK_SIZE=1000000

# OCI Object Storage S3 compatibility endpoint (Singapore).
# Use read-only OCI credentials for the notebook and write credentials for the pipeline.
S3_ENDPOINT=https://ax7w18msxzt6.compat.objectstorage.ap-singapore-1.oci.customer-oci.com
S3_REGION=ap-singapore-1
S3_ACCESS_KEY=replace_with_oci_access_key
S3_SECRET_KEY=replace_with_oci_secret_key
DATA_BUCKET=raw-zone
# Only the ingestion job or an authorized operator needs this bucket.
STATE_BUCKET=system-state
